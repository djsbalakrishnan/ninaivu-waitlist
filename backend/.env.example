SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon — copy the connection string from neon.tech dashboard
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Upstash — copy the TLS connection string from upstash.com Redis console
REDIS_URL=rediss://default:password@host.upstash.io:6379

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email — in DEBUG mode emails print to the terminal (console backend).
# These are only needed in production.
# Brevo SMTP: get EMAIL_HOST_USER and EMAIL_HOST_PASSWORD from
# Brevo dashboard → SMTP & API → SMTP → Generate a new SMTP key
DEFAULT_FROM_EMAIL=hello@ninaivu.in
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-login@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
